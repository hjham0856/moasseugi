// 모아쓰기 범위 축소 모델 (2026-10-03)
// 개발: H2 local(create-drop). 개발 완료 마지막 단계: PostgreSQL.
// UUID 생성 방식과 PostgreSQL 연결/스키마 적용 방식은 마지막 전환 때 확정한다.

Project moasseugi {
  database_type: 'PostgreSQL'
  Note: '독립 작성·익명 평가·분포 확인·채택. 현재 구현 개발 DB는 H2.'
}

Enum SessionStatus {
  WRITING    [note: '작성 중. 신규 참가와 아이디어 저장·수정 가능']
  EVALUATING [note: '평가 중. 기존 참가자의 평가 저장·변경 가능']
  RESULT     [note: '평가 종료. 분포 확인·1회 채택. 채택 후에도 같은 상태']
}

Table sessions {
  id uuid [pk]
  title varchar(200) [not null]
  description text
  status SessionStatus [not null, default: 'WRITING']
  selected_idea_id uuid [note: 'RESULT에서 한 번만 설정. 채택 전 NULL. 이 안건의 아이디어만 가능']
  Note: '''
  생성 트랜잭션에서 진행자 participant를 함께 만든다. 진행자도 작성·평가에 참여한다.
  진행자가 수동으로 WRITING→EVALUATING→RESULT 전환한다. 자동 마감·되돌리기 없음.
  아이디어 0개면 EVALUATING 전환 거부. 평가 0건이어도 RESULT 전환 가능.
  selected_idea_id로 채택 여부를 표현한다. 별도 COMPLETED·NO_IDEAS 상태 없음.
  '''
}

Table participants {
  id uuid [pk]
  session_id uuid [not null]
  nickname varchar(30) [not null, note: '같은 안건에서 중복 금지. 공백·대소문자 비교 방식은 구현 때 확인']
  reconnect_token varchar(255) [not null, unique, note: '안건별 랜덤 참가 키. 생성자에게도 발급. 만료·복구 정책 없음']
  is_host boolean [not null, default: false]
  indexes {
    (session_id, nickname) [unique]
  }
  Note: '''
  생성자가 유일한 진행자다. 안건당 진행자 1명 규칙은 생성 로직에서 유지한다.
  신규 참가는 WRITING에서만 가능하며 기존 참가자는 이후 단계에도 접근한다.
  키가 해당 안건의 참가자 키인지 확인한다. 닉네임이나 admin URL 값으로 소유자·권한을 판정하지 않는다.
  키 분실 시 기록 복구·이전 없음. JWT·user_id·24시간 만료 컬럼은 지금 필요하지 않다.
  닉네임의 비교 정책 확정 후 필요하면 정규화용 컬럼/제약을 맞춘다.
  '''
}

Table ideas {
  id uuid [pk]
  participant_id uuid [not null, unique, note: '참가자당 최대 1개. 같은 참가자의 저장 요청은 이 행을 갱신']
  content text [not null, note: '공백만 있는 내용 거부']
  Note: '''
  WRITING에서만 저장·수정, 삭제 API 없음. 소유자는 참가 키로 찾는다.
  소속 안건은 participant_id로 확인한다. 참가자당 1개는 DB UNIQUE로도 보장한다.
  작성 중에는 다른 참가자의 아이디어를 공개하지 않는다.
  '''
}

Table evaluations {
  id uuid [pk]
  participant_id uuid [not null]
  idea_id uuid [not null]
  value smallint [not null, note: '-1 별로, 0 괜찮음, 1 좋음']
  indexes {
    (participant_id, idea_id) [unique]
    idea_id
  }
  Note: '''
  선택할 때마다 저장하며 기존 조합이면 value를 갱신한다. 별도 제출 없음.
  EVALUATING에서만 저장·변경. 본인 아이디어 평가 불가. 참가자와 아이디어는 같은 안건이어야 한다.
  저장되지 않은 평가는 행이 없다. total = positive + neutral + negative이며 저장된 평가만 집계한다.
  해당 아이디어의 total이 0이면 결과에서 분포 대신 평가 없음 표시. 아이디어는 계속 표시하고 채택 가능.
  '''
}

Ref: participants.session_id > sessions.id
Ref: ideas.participant_id > participants.id
Ref: evaluations.participant_id > participants.id
Ref: evaluations.idea_id > ideas.id
Ref: sessions.selected_idea_id > ideas.id

// 공통 BaseEntity·자동 감사 시각·회원 테이블은 현재 범위에 없다.
// 닉네임 비교 방식과 PostgreSQL의 CHECK(value IN (-1,0,1)) 등 제약 적용은 구현/전환 때 검증한다.
